{
  "name": "orbit-dj-studio",
  "version": "0.9.0",
  "private": true,
  "main": "desktop/main.cjs",
  "type": "module",
  "description": "Local-first four-deck DJ studio",
  "scripts": {
    "start": "node server.mjs",
    "desktop": "electron .",
